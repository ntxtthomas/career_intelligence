<% content_for :title, "Guides" %>

<div class="page-header" style="padding-top: 1.5rem;">
  <div class="page-header-content">
    <h1 class="page-title">Guides</h1>
  </div>
</div>

<%= render "shared/interview_hub_nav", active: :guides %>

<section class="resource-guides-section">
  <div class="resource-guide-cards">
    <%= link_to behavioral_guide_path, class: "resource-guide-card" do %>
      <h3>Behavioral Prep Guide</h3>
      <p>Common behavioral questions, what they assess, and strong response patterns.</p>
    <% end %>

    <%= link_to technical_guide_path, class: "resource-guide-card" do %>
      <h3>Technical Prep Guide</h3>
      <p>Common technical questions, interviewer intent, and response strategy.</p>
    <% end %>

    <%= link_to interviewer_questions_guide_path, class: "resource-guide-card" do %>
      <h3>Questions for Interviewers</h3>
      <p>Thoughtful questions to ask across recruiter, manager, panel, and final rounds.</p>
    <% end %>

    <%= link_to acquired_questions_guide_path, class: "resource-guide-card" do %>
      <h3>Acquired Questions</h3>
      <p>Questions and challenges learned from real interview experiences.</p>
    <% end %>
  </div>
</section>
