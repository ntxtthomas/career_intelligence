<% content_for :title, "Companies" %>

<div class="page-header">
  <div class="page-header-content">
    <h1 class="page-title" style="padding-top: 1.5rem;">Companies</h1>
  </div>
</div>

<div class="card opportunities-filters-card">
  <div class="opportunities-toolbar">
    <div class="opportunities-filter-group">
      <%= form_with url: companies_path, method: :get, local: true, class: "opportunities-filter-form" do |f| %>
        <%= hidden_field_tag :company_query, params[:company_query] %>
        <%= hidden_field_tag :industry_id, params[:industry_id] %>
        <label for="preferred_filter" class="form-label opportunities-status-label"></label>
        <%= f.select :preferred, 
            [["All Companies", ""], ["Preferred Only", "true"], ["Not Preferred Only", "false"]],
            { selected: params[:preferred] || "" },
            id: "preferred_filter",
            class: "form-select opportunities-status-select" %>
        <%= f.submit "Filter", class: "btn btn-primary" %>
        <% if params[:preferred].present? %>
          <%= link_to "Clear", companies_path(company_query: params[:company_query], industry_id: params[:industry_id]), class: "btn btn-secondary" %>
        <% end %>
      <% end %>
      |
      <%= form_with url: companies_path, method: :get, local: true, class: "opportunities-filter-form" do |f| %>
        <%= hidden_field_tag :company_query, params[:company_query] %>
        <%= hidden_field_tag :preferred, params[:preferred] %>
        <label for="industry_filter" class="form-label opportunities-status-label"></label>
        <%= f.select :industry_id,
            options_from_collection_for_select(@industries, :id, :full_name, params[:industry_id]),
            { include_blank: "All Industries" },
            id: "industry_filter",
            class: "form-select opportunities-status-select" %>
        <%= f.submit "Filter", class: "btn btn-primary" %>
        <% if params[:industry_id].present? %>
          <%= link_to "Clear", companies_path(company_query: params[:company_query], preferred: params[:preferred]), class: "btn btn-secondary" %>
        <% end %>
      <% end %>
      |
      <%= form_with url: companies_path, method: :get, local: true, class: "opportunities-filter-form" do |f| %>
        <%= hidden_field_tag :technology, params[:technology] %>
        <%= hidden_field_tag :industry_id, params[:industry_id] %>
        <%= f.text_field :company_query, value: params[:company_query], placeholder: "Search company", class: "form-input opportunities-company-input" %>
        <%= f.submit "Search", class: "btn btn-primary" %>
        <% if params[:company_query].present? %>
          <%= link_to "Clear", companies_path(technology: params[:technology], industry_id: params[:industry_id]), class: "btn btn-secondary" %>
        <% end %>
      <% end %>
    </div>

    <div class="opportunities-actions">
      <%= link_to "+", new_company_path, class: "btn btn-primary btn-lg" %>
    </div>
  </div>
</div>

<div id="companies" class="table-container">
  <table>
    <thead>
      <tr>
        <th><%= sortable_link :name %></th>
        <th><%= sortable_link :industry %></th>
        <th><%= sortable_link :company_type, "Type" %></th>
        <th><%= sortable_link :location %></th>
        <th><%= sortable_link :size, "Size" %></th>
        <th><%= sortable_link :preferred, "Preferred" %></th>
        <th><%= sortable_link :website %></th>
        <th><%= sortable_link :linkedin %></th>
        <th>Tech Stack</th>
      </tr>
    </thead>
    <tbody>
      <% @companies.each do |company| %>
      <%= render company %>
      <% end %>
    </tbody>
  </table>
</div>
