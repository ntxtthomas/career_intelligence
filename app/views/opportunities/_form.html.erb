<div data-controller="role-type">
<%= form_with(model: opportunity) do |form| %>
<% if opportunity.errors.any? %>
<div style="color: red">
  <h2><%= pluralize(opportunity.errors.count, "error") %> prohibited this opportunity from being saved:</h2>

  <ul>
    <% opportunity.errors.each do |error| %>
    <li><%= error.full_message %></li>
    <% end %>
  </ul>
</div>
<% end %>

<div class="form-group">
  <%= form.label :role_type, "Role Type", style: "display: block" %>
  <%= form.select :role_type, 
      options_for_select(
        Opportunity::ROLE_TYPES.map { |k, v| [v, k] }, 
        opportunity.role_type || "software_engineer"
      ), 
      { prompt: "Select role type" }, 
      { style: "display: block; width: 250px; height: 30px;", 
        data: { 
          role_type_target: "select",
          action: "change->role-type#toggle" 
        } } %>
</div>

<div class="form-group">
  <%= form.label :company_id, "Company", style: "display: block" %>
  <%= form.select :company_id, 
      options_from_collection_for_select(
        defined?(@companies) ? @companies : Company.all.order(:name), 
        :id, 
        :name, 
        opportunity.company_id
      ), 
      { prompt: "Select a company" }, 
      { style: "display: block; width: 250px; height: 30px;" } %>
</div>

<div class="form-group">
  <%= form.label :position_title, style: "display: block" %>
  <%= form.text_field :position_title, style: "width: 250px; height: 25px;" %>
</div>

<div class="form-group fifteen-width-field">
  <%= form.label :application_date, style: "display: block" %>
  <%= form.date_field :application_date, style: "width: 250px; height: 25px;" %>
</div>

<div class="form-group">
  <%= form.label :status, style: "display: block" %>
  <%= form.select :status, 
      options_for_select([
        ["Applied", "applied"],
        ["Interviewing", "interviewing"],
        ["Closed", "closed"]
      ], opportunity.status), 
      { include_blank: "Select status" }, 
      { style: "display: block; width: 250px; height: 30px;" } %>
</div>

<div class="form-group">
  <%= form.label :remote, style: "display: block" %>
  <%= form.check_box :remote, { checked: opportunity.remote.nil? ? true : opportunity.remote }, "true", "false" %>
</div>

<!-- Role-specific metadata fields -->
<div id="role-specific-fields">
  <!-- Software Engineer Fields -->
  <div data-role-type-target="section" data-role="software_engineer" style="<%= opportunity.role_type == 'software_engineer' || opportunity.role_type.blank? ? '' : 'display: none;' %>">
    <div class="form-group full-width-field" data-controller="technology-picker">
      <%= form.label "Technologies" %>
      <label for="opportunity_technology_paste" class="form-label">Paste Tech Stack</label>
      <div style="display: flex; gap: 0.5rem; align-items: flex-start; margin-bottom: 0.5rem;">
        <textarea id="opportunity_technology_paste" class="form-input technology-picker-input" rows="2" placeholder="Ruby on Rails, PostgreSQL, React" data-technology-picker-target="input"></textarea>
        <button type="button" class="btn btn-secondary" data-action="technology-picker#apply">Apply</button>
      </div>
      <p class="form-hint" data-technology-picker-target="result" aria-live="polite"></p>
      <div style="max-height: 300px; overflow-y: auto; border: 1px solid #ddd; padding: 10px; border-radius: 4px; background-color: var(--bg-primary, #fff);">
      <% Technology::CATEGORIES.each do |category| %>
        <% techs = Technology.where(category: category).order(:name) %>
        <% next if techs.empty? %>
        
        <fieldset style="margin-bottom: 15px; border: none; padding: 0;">
          <legend style="font-weight: bold; color: var(--text-primary, #333); margin-bottom: 5px;"><%= category %></legend>
          <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 5px;">
            <% techs.each do |tech| %>
              <label style="display: flex; align-items: center; cursor: pointer;">
                <%= check_box_tag "opportunity[technology_ids][]", tech.id, opportunity.technologies.include?(tech) || (opportunity.new_record? && tech.name == "Ruby on Rails"), id: "opportunity_technology_ids_#{tech.id}", data: { technology_picker_target: "checkbox", technology_name: tech.name } %>
                <span style="margin-left: 5px; font-size: 14px;"><%= tech.name %></span>
              </label>
            <% end %>
          </div>
        </fieldset>
      <% end %>
      </div>
      <%= hidden_field_tag "opportunity[technology_ids][]", "" %>
    </div>

    <div class="form-group full-width-field">
      <%= form.label :other_tech_stack, "Other Technologies (not listed above)", style: "display: block; margin-top: 10px;" %>
        <%= form.rich_text_area :other_tech_stack, placeholder: "e.g., Custom framework, proprietary tools..." %>
    </div>
  </div>

  <!-- Sales Engineer Fields -->
  <div data-role-type-target="section" data-role="sales_engineer" style="<%= opportunity.role_type == 'sales_engineer' ? '' : 'display: none;' %>">
    <%= render "sales_engineer_fields", opportunity: opportunity %>
  </div>

  <!-- Solutions Engineer Fields -->
  <div data-role-type-target="section" data-role="solutions_engineer" style="<%= opportunity.role_type == 'solutions_engineer' ? '' : 'display: none;' %>">
    <%= render "solutions_engineer_fields", opportunity: opportunity %>
  </div>

  <!-- Product Manager Fields -->
  <div data-role-type-target="section" data-role="product_manager" style="<%= opportunity.role_type == 'product_manager' ? '' : 'display: none;' %>">
    <%= render "product_manager_fields", opportunity: opportunity %>
  </div>

  <!-- Support Engineer Fields -->
  <div data-role-type-target="section" data-role="support_engineer" style="<%= opportunity.role_type == 'support_engineer' ? '' : 'display: none;' %>">
    <%= render "support_engineer_fields", opportunity: opportunity %>
  </div>

  <!-- Success Engineer Fields -->
  <div data-role-type-target="section" data-role="success_engineer" style="<%= opportunity.role_type == 'success_engineer' ? '' : 'display: none;' %>">
    <%= render "success_engineer_fields", opportunity: opportunity %>
  </div>

  <!-- Other Fields -->
  <div data-role-type-target="section" data-role="other" style="<%= opportunity.role_type == 'other' ? '' : 'display: none;' %>">
    <%= render "other_fields", opportunity: opportunity %>
  </div>
</div>

<div class="form-group fifteen-width-field">
  <%= form.label :source, style: "display: block" %>
  <%= form.select :source, 
      options_for_select([
        ["AngelList", "angellist"],
        ["Braintrust", "braintrust"],
        ["Company Website", "company_website"],
        ["Dice", "dice"],
        ["Glassdoor", "glassdoor"],
        ["gun.io", "gun.io"],
        ["Indeed", "indeed"],
        ["Job Fair", "job_fair"],
        ["JobrightAI", "jobrightai"],
        ["lemon.io", "lemon.io"],
        ["LinkedIn", "linkedin"],
        ["Other", "other"],
        ["Recruiter", "recruiter"],
        ["Referral", "referral"],
        ["Toptal", "toptal"],
        ["Upwork", "upwork"],
        ["Wellfound", "wellfound"],
        ["Y Combinator", "y_combinator"],
        ["ZipRecruiter", "ziprecruiter"]
      ], opportunity.source), 
      { prompt: "Select source" }, 
      { style: "display: block; width: 250px; height: 30px;" } %>
</div>

<div class="form-group fifteen-width-field">
  <%= form.label :acquisition_channel, "Acquisition Channel", style: "display: block" %>
  <%= form.select :acquisition_channel,
      options_for_select(
        Opportunity.acquisition_channels.keys.map { |k| [k.humanize, k] },
        opportunity.acquisition_channel
      ),
      { prompt: "Select channel" },
      { style: "display: block; width: 250px; height: 30px;" } %>
</div>

<div class="form-group fifteen-width-field">
  <%= form.label :domain_match, "Domain Match", style: "display: block" %>
  <small style="color: #666; display: block; margin-top: 4px;">Suggested from company industry — editable.</small>
  <%= form.select :domain_match,
      options_for_select(
        Opportunity.domain_matches.keys.map { |k| [k.humanize, k] },
        opportunity.domain_match
      ),
      { prompt: "Select domain match" },
      { style: "display: block; width: 250px; height: 30px;" } %>
</div>

<div class="form-group">
  <%= form.label :fit_map_used, "Fit Map Used", style: "display: block" %>
  <%= form.check_box :fit_map_used %>
</div>

<div class="form-group fifteen-width-field">
  <%= form.label :response_type, "Response Type", style: "display: block" %>
  <%= form.select :response_type,
      options_for_select(
        Opportunity.response_types.keys.map { |k| [k.humanize, k] },
        opportunity.response_type
      ),
      { prompt: "Select response type" },
      { style: "display: block; width: 250px; height: 30px;" } %>
</div>

<div class="form-group full-width-field">
  <%= form.label :notes, style: "display: block" %>
    <%= form.rich_text_area :notes %>
</div>

<div class="form-group fifteen-width-field">
  <%= form.label :salary_range, style: "display: block" %>
  <%= form.text_field :salary_range, style: "width: 250px; height: 25px;" %>
</div>

<div class="form-group fifteen-width-field">
  <%= form.label :bus_factor, "Bus Factor (1-10)", style: "display: block" %>
  <small style="color: #666; display: block; margin-top: 4px;">How many key people leaving would collapse the project/company? (1=very fragile, 10=very stable)</small>
  <%= form.number_field :bus_factor, min: 1, max: 10, style: "width: 100px; height: 25px;" %>
</div>

<div class="form-group fifteen-width-field">
  <%= form.label :listing_url, "Listing URL", style: "display: block" %>
  <%= form.url_field :listing_url, placeholder: "https://...", style: "width: 250px; height: 25px;" %>
</div>

<div class="form-group ten-width-field">
  <%= form.label :chatgpt_match, "ChatGPT Match", style: "display: block" %>
  <%= form.text_field :chatgpt_match, placeholder: "e.g., 85%", style: "height: 25px;" %>
</div>

<div class="form-group ten-width-field">
  <%= form.label :jobright_match, "Jobright Match", style: "display: block" %>
  <%= form.text_field :jobright_match, placeholder: "e.g., 90%", style: "height: 25px;" %>
</div>

<div class="form-group ten-width-field">
  <%= form.label :linkedin_match, "LinkedIn Match", style: "display: block" %>
  <%= form.select :linkedin_match, 
      options_for_select([
        ["Low", "low"],
        ["Medium", "medium"],
        ["Top", "top"]
      ], opportunity.linkedin_match), 
      { prompt: "Select" }, 
      { style: "display: block; width: 145px; height: 25px;" } %>
</div>

<div>
  <%= form.submit class: "btn btn-primary", style: "margin-top: 20px;" %>
</div>
<% end %>
</div>
